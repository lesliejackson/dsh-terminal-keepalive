{
  "name": "@local/dsh-terminal-keepalive",
  "version": "1.0.1",
  "description": "Keeps the right-sidebar terminal mounted across tab and session switches and pauses output from hidden terminals when they get busy.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "terminal",
    "xterm",
    "keepalive"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesliejackson/dsh-terminal-keepalive.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
